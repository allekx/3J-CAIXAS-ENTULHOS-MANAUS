NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor — nunca prefixar com NEXT_PUBLIC_
# Aceita a chave legada `service_role` (eyJ...) ou a nova `sb_secret_...`
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_COMPANY_WHATSAPP=

# URL pública canônica em produção (SEO: nome do site, canonical, sitemap, Open Graph, JSON-LD)
# Ex.: https://www.3jcaixasentulhosmanaus.com
NEXT_PUBLIC_SITE_URL=

# Links da página /bio (opcional — sobrescreve os padrões em src/constants/bio.ts)
# Padrão do CTA “Ir para o site”: / (landing)
NEXT_PUBLIC_BIO_WEBSITE_URL=
# Padrão: https://www.instagram.com/3_j_caixas_entulhos_manaus
NEXT_PUBLIC_BIO_INSTAGRAM_URL=
# Padrão: https://www.youtube.com/@jadaildodasilvagomes1401
NEXT_PUBLIC_YOUTUBE_URL=

# Opcional — contato da empresa no PDF da proposta
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=

# Opcional — rate limit da API pública (recomendado em produção na Vercel)
# Sem estas variáveis, o limite usa memória do processo (ok em localhost)
# Marketplace Vercel: Upstash Redis → injeta automaticamente
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
